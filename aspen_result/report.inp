DYNAMICS
    DYNAMICS RESULTS=ON

TITLE 'PRO-BEN' 

IN-UNITS MET VOLUME-FLOW='cum/hr' ENTHALPY-FLO='Gcal/hr'  &
        HEAT-TRANS-C='kcal/hr-sqm-K' PRESSURE=bar TEMPERATURE=C  &
        VOLUME=cum DELTA-T=C HEAD=meter MASS-DENSITY='kg/cum'  &
        MOLE-ENTHALP='kcal/mol' MASS-ENTHALP='kcal/kg'  &
        MOLE-VOLUME='cum/kmol' HEAT=Gcal MOLE-CONC='mol/l'  &
        PDROP=bar SHORT-LENGTH=mm 

DEF-STREAMS CONVEN ALL 

MODEL-OPTION 

DESCRIPTION "
    Chemical Simulation with Metric Units : 
    C, bar, kg/hr, kmol/hr, Gcal/hr, cum/hr. 
      
    Property Method: NRTL 
      
    Flow basis for input: Mole 
      
    Stream report composition: Mole flow 
    "

DATABANKS 'APV140 PURE40' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' &
         / 'APV140 INORGANIC' / 'APESV140 AP-EOS' /  &
        'NISTV140 NIST-TRC' / NOASPENPCD

PROP-SOURCES 'APV140 PURE40' / 'APV140 AQUEOUS' /  &
        'APV140 SOLIDS' / 'APV140 INORGANIC' / 'APESV140 AP-EOS' &
         / 'NISTV140 NIST-TRC'

COMPONENTS 
    PROPENE C3H6-2 / 
    BENZENE C6H6 / 
    PRO-BEN C9H12-2 

ADA-SETUP 
    ADA-SETUP PROCEDURE=REL9 

SOLVE 
    RUN-MODE MODE=SIM 

FLOWSHEET 
    BLOCK REACTOR IN=FEED RECYCLE OUT=REAC-OUT 
    BLOCK COOLER IN=REAC-OUT OUT=COOL-OUT 
    BLOCK SEP IN=COOL-OUT OUT=RECYCLE PRODUCT 

PROPERTIES RK-SOAVE 
    PROPERTIES NRTL 

PROP-DATA NRTL-1
    IN-UNITS MET VOLUME-FLOW='cum/hr' ENTHALPY-FLO='Gcal/hr'  &
        HEAT-TRANS-C='kcal/hr-sqm-K' PRESSURE=bar TEMPERATURE=C  &
        VOLUME=cum DELTA-T=C HEAD=meter MASS-DENSITY='kg/cum'  &
        MOLE-ENTHALP='kcal/mol' MASS-ENTHALP='kcal/kg'  &
        MOLE-VOLUME='cum/kmol' HEAT=Gcal MOLE-CONC='mol/l'  &
        PDROP=bar SHORT-LENGTH=mm 
    PROP-LIST NRTL 
    BPVAL PROPENE BENZENE 0.0 -3.794700000 .3000000000 0.0 0.0  &
        0.0 25.00000000 25.00000000 
    BPVAL BENZENE PROPENE 0.0 151.4452000 .3000000000 0.0 0.0  &
        0.0 25.00000000 25.00000000 
    BPVAL BENZENE PRO-BEN 0.0 54.48020000 .3000000000 0.0 0.0  &
        0.0 81.60000000 136.4000000 
    BPVAL PRO-BEN BENZENE 0.0 -44.66900000 .3000000000 0.0 0.0  &
        0.0 81.60000000 136.4000000 

STREAM FEED 
    SUBSTREAM MIXED TEMP=105. PRES=0.25 <MPa> 
    MOLE-FLOW PROPENE 18. / BENZENE 18. 

BLOCK COOLER HEATER 
    PARAM TEMP=54. PRES=-0.7 <kPa> DPPARMOPT=NO 

BLOCK SEP FLASH2 
    PARAM PRES=0. <MPa> DUTY=0. <kW> 

BLOCK REACTOR RSTOIC 
    PARAM PRES=0.1 <MPa> DUTY=0. <kW> 
    STOIC 1 MIXED PROPENE -1. / BENZENE -1. / PRO-BEN 1. 
    CONV 1 MIXED PROPENE 0.9 

EO-CONV-OPTI 

STREAM-REPOR MOLEFLOW 
